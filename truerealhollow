@import url('https://discordstyles.github.io/FrostedGlass/FrostedGlass.css');
@import url('https://discordstyles.github.io/Addons/windows-titlebar.css');

:root {
  --background-image: url('https://wallpaperaccess.com/full/1703238.jpg');
  --background-image-blur: 0px;
  --background-image-size: 100%;
  --background-image-position: center;
  --popout-image: var(--background-image);
  --popout-image-blur: 5px;
  --popout-image-size: cover;
  --popout-image-position: center;
  --overlay-image: var(--background-image);
  --overlay-image-blur: 5px;
  --overlay-image-size: cover;
  --overlay-image-position: center;
  --home-button-image: url('https://hollowknight.wiki.fextralife.com/file/Hollow-Knight/char_hollow_knight_wiki_infobox.png');
  --home-button-size: cover;
  --home-button-position: center;
  --serverlist-brightness: 0.92;
  --left-brightness: 0.8;
  --middle-brightness: 0.6;
  --right-brightness: 0;
  --overlay-brightness: 0.75;
  --gradient-primary: 255,255,255;
  --gradient-secondary: 124,124,124;
  --link-colour: #0095CE;
  --scrollbar-colour: rgba(255,255,255,0.05);
  --gradient-direction: 184deg;
  --tint-colour: 255,0,135;
  --tint-brightness: 0;
  --font: gg sans;
  --window-padding: 20px;
  --window-roundness: 10px;
  --update-notice-1: none;
}

